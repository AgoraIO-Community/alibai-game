# Copy to .env.local. Never commit populated values.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback only, if your Supabase project does not use modern keys:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Offline case generation is optional; fixtures need no model API key.
SCENARIO_LLM_URL=
SCENARIO_LLM_API_KEY=
SCENARIO_LLM_MODEL=
# Optional independent reviewer; without review, model output stays a draft.
SCENARIO_REVIEW_LLM_URL=
SCENARIO_REVIEW_LLM_API_KEY=
SCENARIO_REVIEW_LLM_MODEL=

# Existing Agora project: testing. CLI writes these to .env.local:
# agora project env write .env.local --project testing --template nextjs --append --json
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=

# Voice pipeline: Agora-managed ARES + gpt-4o-mini + MiniMax.
# No ASR/LLM/TTS provider keys are required for that managed pipeline.
# Voice IDs are selected from the per-avatar catalog and frozen on each session.
# No global MINIMAX_VOICE_ID override is used.

# Anam video remains BYOK. This key is SERVER-ONLY.
# Actor IDs come from the approved catalog and are persisted per session.
ANAM_API_KEY=

# Future optional BYOK/custom voice integrations (not read by the current adapter):
# SUSPECT_LLM_URL=
# SUSPECT_LLM_API_KEY=
# SUSPECT_LLM_MODEL=
# GRADIUM_API_KEY=
# GRADIUM_VOICE_ID=

# Development-only manual clock test; leave false for production voice.
ENABLE_MANUAL_INTERVIEW=false
